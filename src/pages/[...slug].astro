---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { extractRelated } from '../lib/related';
import { rewriteInterlinks } from '../lib/interlinks';
import { formatFullDate } from '../lib/format';
import { buildDomainChain, chainNeighbors } from '../lib/navigation';
import { loadTags } from '../lib/tags';
import ArticleNav from '../components/ArticleNav.astro';

export async function getStaticPaths() {
  const ai = await getCollection('ai');
  const stack = await getCollection('stack');
  const all = [...ai, ...stack];
  return all.map((entry) => ({
    params: { slug: `${entry.collection}/${entry.id}` },
    props: {
      entry,
      dom: entry.collection,
      all,
      related: extractRelated(entry, all, import.meta.env.BASE_URL),
    },
  }));
}

const { entry, dom, all, related } = Astro.props;
const base = import.meta.env.BASE_URL;
const { headings } = await render(entry);
// 正文互链在页面层改写为绝对路由并校验目标存在（渲染管线拿不到源文件路径，见 lib/interlinks.ts）
if (entry.body && !entry.rendered?.html) {
  throw new Error(`[article] ${entry.collection}/${entry.id} 没有预渲染产物，正文会静默丢失，拒绝构建`);
}
const bodyHtml = rewriteInterlinks(entry.rendered?.html ?? '', entry, all, base);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const domName = dom === 'ai' ? 'AI / Agent' : '全栈开发';
// 左栏「全部笔记」与文末「上一篇 / 下一篇」共用同一条学习路径链（标签清单顺序 × 组内文件名序）
const domainTags = loadTags()[dom];
const domainArticles = all.filter((e) => e.collection === dom);
const { prev, next } = chainNeighbors(buildDomainChain(domainTags, domainArticles), entry.id);
---
<Layout title={`${entry.data.title} · 格致`} description={entry.data.summary} dom={dom} active={dom} ogType="article">
  <div class="wrap">
    <div class="art-layout">
      <ArticleNav domainTags={domainTags} articles={domainArticles} currentId={entry.id} base={base} dom={dom} />

      <div>
        <div class="art-meta">
          <div class="crumb">
            <a href={base}>首页</a> / <a href={`${base}${dom}/`}>{domName}</a> / {entry.data.tags[0]}
          </div>
          <h1>{entry.data.title}</h1>
          <div class="artline">
            <span class="date">{formatFullDate(entry.data.date)}</span>
            {entry.data.tags.map((tag) => <span class="mini-tag">{tag}</span>)}
          </div>
        </div>

        <div class="art-body">
          <Fragment set:html={bodyHtml} />
          {
            related.length > 0 && entry.data.related !== false && (
              <div class="relbox">
                <h3>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
                  相关笔记（文内互链）
                </h3>
                <ul>
                  {related.map((r) => (
                    <li><span>{r.dateShort}</span><a href={r.url}>{r.title}</a></li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        {(prev || next) && (
          <div class="pn-nav">
            {prev ? (
              <a class="pn-prev" href={`${base}${dom}/${prev.id}/`}>
                <span class="pn-d">上一篇 · 学习路径</span>
                <span class="pn-t">{prev.data.title}</span>
              </a>
            ) : (
              <span class="pn-spacer"></span>
            )}
            {next && (
              <a class="pn-next" href={`${base}${dom}/${next.id}/`}>
                <span class="pn-d">下一篇 · 学习路径</span>
                <span class="pn-t">{next.data.title}</span>
              </a>
            )}
          </div>
        )}
      </div>

      <aside class="toc">
        <div class="toc-t">目录 / TOC</div>
        {toc.map((h) => (
          <a class:list={[{ l2: h.depth === 3 }]} href={`#${h.slug}`}>{h.text.replace(/^§\s*\d+\s*/, '')}</a>
        ))}
      </aside>
    </div>
  </div>
</Layout>
