---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="404 · 格致" description="页面不存在">
  <div class="wrap">
    <div class="not-found">
      <div class="nf-code">404</div>
      <h1>这一页还不存在</h1>
      <p>地址可能输错了，或者笔记还没写出来。</p>
      <div class="nf-links">
        <a href={base}>回首页</a>
        <a href={`${base}ai/`}>AI / Agent</a>
        <a href={`${base}stack/`}>全栈开发</a>
      </div>
    </div>
  </div>
</Layout>
