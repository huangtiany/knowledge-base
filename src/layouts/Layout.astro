---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 领域色作用域：ai / backend / front；首页与 About 不注入 */
  dom?: 'ai' | 'backend' | 'front';
  /** 顶栏高亮的导航项 */
  active?: 'ai' | 'backend' | 'front' | 'about';
  /** og:type；文章页传 article */
  ogType?: 'website' | 'article';
}

const { title, description, dom, active, ogType = 'website' } = Astro.props;
const base = import.meta.env.BASE_URL;
const domStyle = dom ? `--dom:var(--${dom});--dom-soft:var(--${dom}-soft)` : undefined;
const ogDescription = description ?? '本地书写 Markdown 的个人知识库：AI / Agent、后端与前端的笔记与资料。';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="格致" href={`${base}rss.xml`} />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="格致" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header>
      <div class="hwrap">
        <a class="brand" href={base}>格致<i>.</i></a>
        <nav class="main">
          <a href={`${base}ai/`} class:list={[{ on: active === 'ai' }]}>AI / Agent</a>
          <a href={`${base}backend/`} class:list={[{ on: active === 'backend' }]}>后端</a>
          <a href={`${base}front/`} class:list={[{ on: active === 'front' }]}>前端</a>
          <a href={`${base}about/`} class:list={[{ on: active === 'about' }]}>关于</a>
        </nav>
        <div class="search">
          <input id="site-search" type="text" placeholder="搜索笔记与资源…" autocomplete="off" />
          <div id="search-results" class="search-results" hidden></div>
        </div>
      </div>
    </header>

    <div class="page" style={domStyle} data-dom={dom}>
      <slot />
    </div>

    <footer>
      <div class="fwrap">
        <span>© 2026 格致</span>
        <span>Markdown · 本地书写 · 展示最新版</span>
      </div>
    </footer>

    <button id="to-top" class="to-top" aria-label="回到顶部" title="回到顶部">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M8 13V3M8 3L3.5 7.5M8 3l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <script>
      // 站内搜索：标题 + 正文全文，构建期生成 search-index.json，前端子串匹配（中文无需分词）。
      // 标题命中优先；正文命中附上下文摘要，命中片段 <mark> 高亮。
      // 命中全量渲染、不做条数截断；超长列表由下拉 max-height + 内部滚动承载。
      // 输入防抖 500ms：停止输入后才检索；清空 / Escape / 点击外部立即收起并取消未触发的检索。
      const input = document.getElementById('site-search') as HTMLInputElement;
      const box = document.getElementById('search-results') as HTMLDivElement;

      interface SearchItem { title: string; dom: string; url: string; text?: string }
      interface SearchHit extends SearchItem { snip: string }
      let index: SearchItem[] | null = null;
      let pending: number | undefined; // 防抖定时器；收起 / 清空 / 回车时取消

      const escapeHtml = (s: string) =>
        s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      async function loadIndex(): Promise<SearchItem[]> {
        if (!index) {
          const res = await fetch(`${import.meta.env.BASE_URL}search-index.json`);
          index = await res.json();
        }
        return index!;
      }

      // 取命中位置前后约 80 字作为上下文，命中片段加 <mark>
      function snippet(text: string, pos: number, qLen: number): string {
        const start = Math.max(0, pos - 30);
        const end = Math.min(text.length, pos + qLen + 50);
        const head = escapeHtml(text.slice(start, pos));
        const hit = escapeHtml(text.slice(pos, pos + qLen));
        const tail = escapeHtml(text.slice(pos + qLen, end));
        return `${start > 0 ? '…' : ''}${head}<mark>${hit}</mark>${tail}${end < text.length ? '…' : ''}`;
      }

      function search(items: SearchItem[], q: string): SearchHit[] {
        const hits: SearchHit[] = [];
        const bodyHits: { it: SearchItem; pos: number }[] = [];
        for (const it of items) {
          if (it.title.toLowerCase().includes(q)) { hits.push({ ...it, snip: '' }); continue; }
          if (!it.text) continue;
          const pos = it.text.toLowerCase().indexOf(q);
          if (pos >= 0) bodyHits.push({ it, pos });
        }
        for (const { it, pos } of bodyHits) {
          hits.push({ ...it, snip: snippet(it.text!, pos, q.length) });
        }
        return hits;
      }

      function render(results: SearchHit[], query: string) {
        if (!query) { box.hidden = true; box.innerHTML = ''; return; }
        if (!results.length) {
          box.innerHTML = '<div class="sr-empty">没有匹配的笔记或资源</div>';
        } else {
          box.innerHTML = results
            .map((r) =>
              `<a href="${r.url}"><span class="sr-dom">${escapeHtml(r.dom)}</span><span class="sr-body"><span class="sr-t">${escapeHtml(r.title)}</span>${r.snip ? `<span class="sr-snip">${r.snip}</span>` : ''}</span></a>`)
            .join('');
        }
        box.hidden = false;
      }

      // 收起下拉并取消尚未触发的防抖检索，供清空 / Escape / 点击外部复用
      function hideResults() {
        clearTimeout(pending);
        pending = undefined;
        box.hidden = true;
        box.innerHTML = '';
      }

      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        if (!q) { hideResults(); return; }
        clearTimeout(pending);
        pending = window.setTimeout(async () => {
          pending = undefined;
          render(search(await loadIndex(), q), q);
        }, 500);
      });

      input.addEventListener('keydown', async (e) => {
        if (e.key === 'Escape') { input.value = ''; hideResults(); return; }
        if (e.key !== 'Enter') return;
        if (pending !== undefined) {
          // 停顿不足 500ms 就回车：立即检索本轮输入，避免跳进上一轮的旧结果
          clearTimeout(pending);
          pending = undefined;
          const q = input.value.trim().toLowerCase();
          if (!q) return;
          render(search(await loadIndex(), q), q);
        }
        const first = box.querySelector('a') as HTMLAnchorElement | null;
        if (first) first.click();
      });

      document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('.search')) hideResults();
      });
    </script>

    <script>
      // 回到顶部：滚过约 0.6 屏出现；尊重 prefers-reduced-motion
      const toTop = document.getElementById('to-top') as HTMLButtonElement;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const toggleToTop = () => {
        toTop.classList.toggle('show', window.scrollY > window.innerHeight * 0.6);
      };
      toggleToTop();
      window.addEventListener('scroll', toggleToTop, { passive: true });

      toTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
      });
    </script>

    <script>
      // 右栏标签目录 scroll-spy：滚动时取 header 下方最近越线的分组标题，
      // 给 [data-spy] 容器内对应锚点标 aria-current 高亮。纯增强，无 JS 时锚点跳转仍可用。
      const spyBox = document.querySelector<HTMLElement>('[data-spy]');
      if (spyBox) {
        const links = new Map<string, HTMLAnchorElement>();
        spyBox.querySelectorAll('a[href^="#"]').forEach((a) => {
          const href = a.getAttribute('href')!;
          const id = decodeURIComponent(href.slice(1));
          if (!links.has(id)) links.set(id, a);
        });
        // 目录顺序 = DOM 中分组顺序，按序扫描取"最近越线"的标题即可
        const targets = [...links.keys()]
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => !!el);
        // setTimeout 节流：与 rAF 等效但更稳（后台标签页 / 无渲染帧环境也能跑）
        let ticking = false;
        const update = () => {
          ticking = false;
          let current: string | null = null;
          for (const t of targets) {
            if (t.getBoundingClientRect().top <= 90) current = t.id;
            else break;
          }
          if (!current && targets.length) current = targets[0].id; // 页首也让目录有落点
          links.forEach((a, id) => {
            if (id === current) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          });
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            setTimeout(update, 80);
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update();
      }
    </script>
  </body>
</html>
